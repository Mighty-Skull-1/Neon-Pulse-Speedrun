{
  "name": "neon-pulse-speedrun",
  "version": "1.0.0",
  "description": "Neon Pulse: Precision Speedrun Edition - desktop (Electron/Steam) build",
  "main": "main.js",
  "steamAppId": "",
  "scripts": {
    "start": "electron .",
    "start:dev": "electron . --dev",
    "serve": "npx serve .",
    "build:css": "npx tailwindcss@3.4.17 -c tailwind.config.js -i tailwind.input.css -o vendor/tailwind.css --minify",
    "build:steam": "electron-builder --win dir",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "keywords": [
    "speedrun",
    "platformer",
    "neon",
    "steam",
    "precision"
  ],
  "author": "Mighty Skull",
  "license": "MIT",
  "dependencies": {
    "peerjs": "1.5.4"
  },
  "optionalDependencies": {
    "steamworks.js": "^0.4.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.mightyskull.neonpulsespeedrun",
    "productName": "Neon Pulse Speedrun",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "game.js",
      "style.css",
      "steam_bridge.js",
      "main.js",
      "preload.js",
      "package.json",
      "LICENSE",
      "vendor/**/*",
      "build/icon.png"
    ],
    "asarUnpack": [
      "node_modules/steamworks.js/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "dir"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "dir"
      ],
      "category": "Game"
    },
    "mac": {
      "category": "public.app-category.games"
    }
  }
}
